 "requirements": [
  {
   "id": "R-01",
   "title": "Plant enable",
   "kind": "enable",
   "text": "The hot water plant is enabled when the schedule is occupied, the outdoor air temperature is below the lockout temperature (291.15 K, 18 °C) and there is at least one hot water plant request. It is disabled when any of those stops holding for 3 minutes; the lockout has a 0.56 K (1 °F) deadband.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.2",
    "fidelity": "paraphrase",
    "paragraph": "plant enable/disable",
    "note": "Section numbers are from the 2021 edition; the 3 min disable delay applies to every disable condition here (designer choice) and the lockout default is 18 °C."
   },
   "conditions": [
    {
     "point": "uSchOn",
     "operator": "eq",
     "value": true
    },
    {
     "point": "TOut",
     "operator": "lt",
     "value": 291.15,
     "deadband": 0.56
    },
    {
     "point": "nReqPla",
     "operator": "gte",
     "value": 1.0
    }
   ],
   "timing": {
    "release_seconds": 180.0
   },
   "outcomes": [
    {
     "point": "yPla",
     "operator": "eq",
     "value": true
    }
   ],
   "otherwise": [
    {
     "point": "yPla",
     "operator": "eq",
     "value": false
    }
   ],
   "parameters": {
    "TOutLockout_K": 291.15,
    "lockoutDeadband_K": 0.56,
    "disableDelay_s": 180.0
   }
  },
  {
   "id": "R-02",
   "title": "Lead boiler follows plant enable",
   "kind": "staging",
   "assumes": [
    "R-01"
   ],
   "text": "With the plant enabled and the lead pump proven, the lead boiler (boiler 1) is enabled; it is disabled whenever the plant is disabled or no pump is proven.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.3",
    "fidelity": "paraphrase",
    "paragraph": "boiler staging"
   },
   "conditions": [
    {
     "point": "uPum1Sta",
     "operator": "eq",
     "value": true
    }
   ],
   "outcomes": [
    {
     "point": "yBoi1",
     "operator": "eq",
     "value": true
    }
   ],
   "otherwise": [
    {
     "point": "yBoi1",
     "operator": "eq",
     "value": false
    }
   ]
  },
  {
   "id": "R-03",
   "title": "Stage up the lag boiler",
   "kind": "staging",
   "assumes": [
    "R-02"
   ],
   "step_seconds": 30.0,
   "text": "With the lead boiler proven and the supply temperature reset settled at its maximum (355.15 K), the lag boiler is enabled when the supply temperature stays more than 2.8 K (5 °F) below the setpoint for 10 minutes. Once staged it stays on until the stage-down condition (R-04) is met.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.3",
    "fidelity": "paraphrase",
    "paragraph": "stage up",
    "note": "The requirement is stated against the reset maximum so the threshold is a number; the logic compares with the live setpoint."
   },
   "setup": [
    {
     "name": "reset settled at its maximum, supply at setpoint",
     "inputs": {
      "nReqRes": 10.0,
      "TSup": 355.15
     },
     "seconds": 3000.0
    }
   ],
   "conditions": [
    {
     "point": "uBoi1Sta",
     "operator": "eq",
     "value": true
    },
    {
     "point": "TSup",
     "operator": "lt",
     "value": 352.35
    }
   ],
   "timing": {
    "delay_seconds": 600.0,
    "tolerance_scans": 1
   },
   "outcomes": [
    {
     "point": "yBoi2",
     "operator": "eq",
     "value": true
    }
   ],
   "otherwise": [
    {
     "point": "yBoi2",
     "operator": "eq",
     "value": false
    }
   ],
   "recovery": [
    {
     "point": "yBoi2",
     "operator": "eq",
     "value": true
    }
   ],
   "parameters": {
    "stageUpDifferential_K": 2.8,
    "stageUpDelay_s": 600.0
   }
  },
  {
   "id": "R-04",
   "title": "Stage down the lag boiler",
   "kind": "staging",
   "assumes": [
    "R-02"
   ],
   "step_seconds": 30.0,
   "text": "With both boilers running and the reset settled at its maximum, the lag boiler is disabled when the supply temperature stays more than 2.8 K above the setpoint for 10 minutes; it stays enabled otherwise, and once staged off it stays off until the stage-up condition (R-03) is met again.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.3",
    "fidelity": "paraphrase",
    "paragraph": "stage down"
   },
   "setup": [
    {
     "name": "reset settled at its maximum, supply at setpoint",
     "inputs": {
      "nReqRes": 10.0,
      "TSup": 355.15
     },
     "seconds": 3000.0
    },
    {
     "name": "lag boiler staged on",
     "inputs": {
      "TSup": 345.15
     },
     "seconds": 720.0
    }
   ],
   "conditions": [
    {
     "point": "TSup",
     "operator": "gt",
     "value": 357.95
    }
   ],
   "timing": {
    "delay_seconds": 600.0,
    "tolerance_scans": 1
   },
   "outcomes": [
    {
     "point": "yBoi2",
     "operator": "eq",
     "value": false
    }
   ],
   "otherwise": [
    {
     "point": "yBoi2",
     "operator": "eq",
     "value": true
    }
   ],
   "recovery": [
    {
     "point": "yBoi2",
     "operator": "eq",
     "value": false
    }
   ],
   "parameters": {
    "stageDownDifferential_K": 2.8,
    "stageDownDelay_s": 600.0
   }
  },
  {
   "id": "R-05",
   "title": "Plant disable stops everything",
   "kind": "safety",
   "text": "When the schedule becomes unoccupied the plant is disabled after the 3 minute delay, and both boilers, both pumps and the pump speed command are off in the same scan.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.2",
    "fidelity": "paraphrase",
    "paragraph": "plant disable"
   },
   "conditions": [
    {
     "point": "uSchOn",
     "operator": "eq",
     "value": false
    }
   ],
   "timing": {
    "delay_seconds": 180.0,
    "tolerance_scans": 1
   },
   "outcomes": [
    {
     "point": "yPla",
     "operator": "eq",
     "value": false
    },
    {
     "point": "yBoi1",
     "operator": "eq",
     "value": false
    },
    {
     "point": "yBoi2",
     "operator": "eq",
     "value": false
    },
    {
     "point": "yPum1",
     "operator": "eq",
     "value": false
    },
    {
     "point": "yPum2",
     "operator": "eq",
     "value": false
    },
    {
     "point": "yPumSpe",
     "operator": "eq",
     "value": 0.0
    }
   ],
   "otherwise": [
    {
     "point": "yPla",
     "operator": "eq",
     "value": true
    },
    {
     "point": "yPum1",
     "operator": "eq",
     "value": true
    }
   ]
  },
  {
   "id": "R-06",
   "title": "Supply temperature reset trims without requests",
   "kind": "reset",
   "assumes": [
    "R-01"
   ],
   "text": "The supply temperature setpoint is reset by trim and respond: initial 344.15 K, minimum 327.15 K, maximum 355.15 K, 10 minute delay after plant enable, 5 minute sample period, 0 ignored requests, trim −1.0 K, respond +1.0 K per request, maximum response +3.0 K. With no reset requests the setpoint has trimmed at least 0.5 K within 900 s of plant enable (the 600 s delay plus one 300 s sample period; the reset may land a scan or two later) and never goes below the minimum; with one request (the trim and one response cancel) it holds its value.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.4",
    "fidelity": "paraphrase",
    "paragraph": "supply temperature reset",
    "note": "Trim and respond parameters are designer defaults in the style of §5.1.14."
   },
   "conditions": [
    {
     "point": "nReqRes",
     "operator": "lte",
     "value": 0.0
    }
   ],
   "timing": {
    "delay_seconds": 900.0,
    "reference": "context",
    "tolerance_scans": 2
   },
   "outcomes": [
    {
     "point": "TSupSet",
     "operator": "lte",
     "value": 343.65
    },
    {
     "point": "TSupSet",
     "operator": "gte",
     "value": 327.15
    }
   ],
   "otherwise": [
    {
     "point": "TSupSet",
     "operator": "gte",
     "value": 344.15
    }
   ],
   "recovery": [
    {
     "point": "TSupSet",
     "operator": "lte",
     "value": 343.65
    },
    {
     "point": "TSupSet",
     "operator": "gte",
     "value": 327.15
    }
   ],
   "parameters": {
    "TSupSetInitial_K": 344.15,
    "TSupSetMin_K": 327.15,
    "TSupSetMax_K": 355.15,
    "delay_s": 600.0,
    "period_s": 300.0,
    "trim_K": -1.0,
    "respond_K": 1.0,
    "maxResponse_K": 3.0
   }
  },
  {
   "id": "R-07",
   "title": "Supply temperature reset responds to requests",
   "kind": "reset",
   "assumes": [
    "R-01"
   ],
   "text": "With two or more reset requests the setpoint has risen at least 0.85 K above its initial value within 900 s of plant enable (the delay plus one sample period) and never exceeds the maximum; with one request (the trim and one response cancel) it stays where it is, so a raised setpoint holds when the requests drop to one.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.4",
    "fidelity": "paraphrase",
    "paragraph": "supply temperature reset"
   },
   "conditions": [
    {
     "point": "nReqRes",
     "operator": "gte",
     "value": 2.0
    }
   ],
   "timing": {
    "delay_seconds": 900.0,
    "reference": "context",
    "tolerance_scans": 2
   },
   "outcomes": [
    {
     "point": "TSupSet",
     "operator": "gte",
     "value": 345.0
    },
    {
     "point": "TSupSet",
     "operator": "lte",
     "value": 355.15
    }
   ],
   "otherwise": [
    {
     "point": "TSupSet",
     "operator": "lte",
     "value": 344.15,
     "tolerance": 0.01
    }
   ],
   "recovery": [
    {
     "point": "TSupSet",
     "operator": "gte",
     "value": 345.0
    },
    {
     "point": "TSupSet",
     "operator": "lte",
     "value": 355.15
    }
   ]
  },
  {
   "id": "R-08",
   "title": "Lead pump runs with the plant",
   "kind": "control",
   "assumes": [
    "R-01"
   ],
   "text": "The lead hot water pump (pump 1 until a rotation) is commanded on whenever the plant is enabled and off when it is disabled.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.5",
    "fidelity": "paraphrase",
    "paragraph": "primary pumps"
   },
   "timing": {
    "release_seconds": 180.0
   },
   "outcomes": [
    {
     "point": "yPum1",
     "operator": "eq",
     "value": true
    }
   ],
   "otherwise": [
    {
     "point": "yPum1",
     "operator": "eq",
     "value": false
    }
   ]
  },
  {
   "id": "R-09",
   "title": "Lag pump stages on flow",
   "kind": "staging",
   "assumes": [
    "R-08"
   ],
   "text": "With pump 1 leading, the lag pump (pump 2) is enabled when the hot water flow exceeds 60 % of design flow (0.006 m3/s) for 5 minutes and disabled when it falls below 40 % (0.004 m3/s) for 5 minutes.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.5",
    "fidelity": "paraphrase",
    "paragraph": "pump staging",
    "note": "Flow ratios are designer defaults for a 0.01 m3/s design flow."
   },
   "conditions": [
    {
     "point": "VHotWat_flow",
     "operator": "gt",
     "value": 0.006,
     "deadband": 0.002
    }
   ],
   "timing": {
    "delay_seconds": 300.0,
    "release_seconds": 300.0,
    "tolerance_scans": 1
   },
   "outcomes": [
    {
     "point": "yPum2",
     "operator": "eq",
     "value": true
    }
   ],
   "otherwise": [
    {
     "point": "yPum2",
     "operator": "eq",
     "value": false
    }
   ],
   "parameters": {
    "VDesign_m3s": 0.01,
    "stageUpRatio": 0.6,
    "stageDownRatio": 0.4
   }
  },
  {
   "id": "R-10",
   "title": "Pump speed rises when loop pressure is low",
   "kind": "loop",
   "assumes": [
    "R-08"
   ],
   "text": "Pump speed is modulated to hold the loop differential pressure at its setpoint (50 kPa) between a minimum of 10 % and 100 %. With the pressure 20 kPa or more below setpoint for 5 minutes the speed is at least 95 %.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.5",
    "fidelity": "paraphrase",
    "paragraph": "pump speed control"
   },
   "conditions": [
    {
     "point": "dpHotWat",
     "operator": "lt",
     "value": 30000.0
    }
   ],
   "timing": {
    "delay_seconds": 300.0,
    "tolerance_scans": 1
   },
   "outcomes": [
    {
     "point": "yPumSpe",
     "operator": "gte",
     "value": 0.95
    }
   ],
   "otherwise": [
    {
     "point": "yPumSpe",
     "operator": "gte",
     "value": 0.1
    },
    {
     "point": "yPumSpe",
     "operator": "lte",
     "value": 1.0
    }
   ],
   "parameters": {
    "dpSet_Pa": 50000.0,
    "speedMin": 0.1
   }
  },
  {
   "id": "R-11",
   "title": "Pump speed falls when loop pressure is high",
   "kind": "loop",
   "assumes": [
    "R-08"
   ],
   "text": "With the loop differential pressure 20 kPa or more above setpoint for 5 minutes the pump speed is at its 10 % minimum (at most 15 %); it never drops below the minimum while a pump runs.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.5",
    "fidelity": "paraphrase",
    "paragraph": "pump speed control"
   },
   "conditions": [
    {
     "point": "dpHotWat",
     "operator": "gt",
     "value": 70000.0
    }
   ],
   "timing": {
    "delay_seconds": 300.0,
    "tolerance_scans": 1
   },
   "outcomes": [
    {
     "point": "yPumSpe",
     "operator": "lte",
     "value": 0.15
    }
   ],
   "otherwise": [
    {
     "point": "yPumSpe",
     "operator": "gte",
     "value": 0.1
    }
   ]
  },
  {
   "id": "R-12",
   "title": "Minimum flow bypass opens on low flow",
   "kind": "loop",
   "assumes": [
    "R-08"
   ],
   "text": "The minimum flow bypass valve is modulated to hold the boiler minimum flow (0.003 m3/s). With the flow at or below 0.001 m3/s for 5 minutes the valve is at least 90 % open.",
   "citation": {
    "document": "ASHRAE Guideline 36-2021",
    "section": "§5.21.6",
    "fidelity": "paraphrase",
    "paragraph": "minimum flow bypass"
   },
   "conditions": [
    {
     "point": "VHotWat_flow",
     "operator": "lt",
     "value": 0.001
    }
   ],
   "timing": {
    "delay_seconds": 300.0,
    "tolerance_scans": 1
   },
   "outcomes": [
    {
     "point": "yByp",
     "operator": "gte",
     "value": 0.9
    }
   ],
   "otherwise": [
    {
     "point": "yByp",
     "operator": "between",
     "value": 0.0,
     "upper": 1.0
    }
   ],
   "parameters": {
    "VMin_m3s": 0.003
   }
  },
  {
   "id": "R-13",
