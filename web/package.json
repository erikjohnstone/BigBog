{
  "name": "bactalk-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "PYTHONPATH=../src ../.venv/bin/python ../scripts/export_openapi.py --output openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "build": "npm run api:generate && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sbom": "cyclonedx-npm --output-file ../artifacts/bactalk-web.cdx.json --spec-version 1.6"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@types/three": "0.186.0",
    "@visx/brush": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@xyflow/react": "12.11.6",
    "cmdk": "1.1.1",
    "dompurify": "3.4.15",
    "geist": "1.7.2",
    "lucide-react": "1.47.0",
    "marked": "18.0.13",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-resizable-panels": "4.12.4",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "three": "0.186.0",
    "uplot": "1.6.32",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
