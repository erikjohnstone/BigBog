# Copy this file to .env and replace the placeholder locally.
# Never commit or paste an API key into the BACTalk UI.
CEREBRAS_API_KEY=replace_with_your_key
CEREBRAS_CHAT_MODEL=gpt-oss-120b
CEREBRAS_CODING_MODEL=qwen-3.8-27b
BACTALK_QUEUE_PASSWORD=bactalk-queue-local-secret
BACTALK_QUEUE_URL=redis://:bactalk-queue-local-secret@127.0.0.1:6380/0
BACTALK_QUALIFICATION_QUEUE=bactalk-qualification
